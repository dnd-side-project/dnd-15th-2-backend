#!/usr/bin/env sh
if [ -n "${QELLO_PYTHON:-}" ]; then
  PYTHON="$QELLO_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "Python 3 is required for Qello Git hooks." >&2
  exit 127
fi

exec "$PYTHON" scripts/run-hook.py commit-msg "$1"
