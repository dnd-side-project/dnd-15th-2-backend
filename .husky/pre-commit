#!/usr/bin/env sh
if [ -n "${MIRI_PYTHON:-}" ]; then
  PYTHON="$MIRI_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "Python 3 is required for Miri Git hooks." >&2
  exit 127
fi

exec "$PYTHON" scripts/run-hook.py pre-commit
