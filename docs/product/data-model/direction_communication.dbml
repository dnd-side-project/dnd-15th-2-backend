Ref fk_question_proposal_proposer: question_proposal.proposer_id > user_account.id [delete: restrict]
Ref fk_question_proposal_review_proposal: question_proposal_review.proposal_id > question_proposal.id [delete: restrict]
Ref fk_question_proposal_review_reviewer: question_proposal_review.reviewer_id > user_account.id [delete: restrict]
Ref fk_recipient_receive_state_user: recipient_receive_state.user_id > user_account.id [delete: cascade]
Ref fk_region_code_parent: region_code.parent_code > region_code.code [delete: restrict]
Ref fk_release_promotion_history_previous_release: release_promotion_history.previous_active_release_id > filter_release.id [delete: no action]
Ref fk_release_promotion_history_release: release_promotion_history.release_id > filter_release.id [delete: no action]
Ref fk_report_answer: report.answer_id > answer.id [delete: restrict]
Ref fk_report_case_answer: report_case.answer_id > answer.id [delete: restrict]
Ref fk_report_case_direction_post: report_case.direction_post_id > direction_post.id [delete: restrict]
Ref fk_report_case_event_case: report_case_event.case_id > report_case.id [delete: restrict]
Ref fk_report_case_target_user: report_case.target_user_id > user_account.id [delete: restrict]
Ref fk_report_content_snapshot_report: report_content_snapshot.report_id > report.id [delete: restrict]
Ref fk_report_direction_post: report.direction_post_id > direction_post.id [delete: restrict]
Ref fk_report_reporter: report.reporter_id > user_account.id [delete: restrict]
Ref fk_report_target_user: report.target_user_id > user_account.id [delete: restrict]
Ref fk_snapshot_emergency_migration_history_snapshot: snapshot_emergency_migration_history.model_snapshot > snapshot_health.model_snapshot [delete: no action]
Ref fk_snapshot_emergency_migration_history_source_release: snapshot_emergency_migration_history.source_release_id > filter_release.id [delete: no action]
Ref fk_snapshot_emergency_migration_history_target_release: snapshot_emergency_migration_history.target_release_id > filter_release.id [delete: no action]
Ref fk_snapshot_health_probe_result_snapshot: snapshot_health_probe_result.model_snapshot > snapshot_health.model_snapshot [delete: no action]
Ref fk_user_account_country: user_account.(country_code, country_level) > region_code.(code, level) [delete: restrict]
Ref fk_user_account_profile_image: user_account.(profile_image_media_id, id) > media_asset.(id, owner_id) [delete: restrict]
Ref fk_user_account_region: user_account.coarse_region_code > region_code.code [delete: restrict]
Ref fk_user_block_blocked: user_block.blocked_id > user_account.id [delete: cascade]
Ref fk_user_block_blocker: user_block.blocker_id > user_account.id [delete: cascade]
Ref fk_user_private_attribute_user: user_private_attribute.user_id > user_account.id [delete: cascade]
Ref notification_report_id_fkey: notification.report_id > report.id [delete: set null]
Ref report_case_id_fkey: report.case_id > report_case.id [delete: restrict]

// -----------------------------------------------------------------------------
// dbdocs 그룹
// -----------------------------------------------------------------------------

// 그룹 색상 #D9EAF7. 계정, 지역, 위치 TTL, 수신 용량
TableGroup account_and_location {
  region_code
  user_account
  user_private_attribute
  active_user_presence
  recipient_receive_state
}

// 그룹 색상 #DCE3EE. 백오피스 운영자와 앱 기기의 인증 자격증명. 제품 논리 스키마가 아니라 백엔드 인증 부록이다
TableGroup authentication {
  operator_credential
  device_credential
}

// 그룹 색상 #DFF2D8. 질문 제안, 운영 검토, 승인 질문, 사용자별 배정
TableGroup question_supply {
  question_proposal
  question_proposal_review
  approved_question
  question_assignment_cycle
  question_assignment
}

// 그룹 색상 #FCE4CC. 방향 정책, 발송 콘텐츠, 수신 권한, 답변과 공감, 미디어
TableGroup direction_communication {
  direction_scheme
  direction_segment
  media_asset
  direction_post
  post_audience
  media_attachment
  post_recipient
  answer
  post_reaction
  answer_reaction
}

// 그룹 색상 #D6EFEA. 자동 필터링과 수동 검토, release 및 snapshot 상태
TableGroup filtering_and_review {
  filter_release
  filter_job
  filter_job_status_history
  filter_decision
  manual_review_case
  manual_review_priority_evaluation
  appeal_case
  release_promotion_history
  filter_release_retry_gate
  snapshot_health
  snapshot_health_probe_result
  snapshot_emergency_migration_history
}

// 그룹 색상 #F8D7DA. 차단, 신고, 운영 판정
TableGroup safety_and_moderation {
  user_block
  report
  report_case
  report_content_snapshot
  report_case_event
  moderation_review
}

// 그룹 색상 #E8D8C9. 운영자의 filtering authority 변경 감사 원장
TableGroup operational_audit {
  operator_action_audit
}

// 그룹 색상 #EADCF0. 앱 내 알림, 푸시 기기·전달, 트랜잭셔널 Outbox
TableGroup notification_and_outbox {
  push_device
  notification_user_setting
  notification_preference
  outbox_event
  notification
  notification_seen_state
  notification_event
  notification_delivery
  push_dispatch_group
  push_dispatch_group_member
  push_daily_budget
}
