  UNREAD [note: '사용자가 아직 확인하지 않은 앱 내 알림']
  READ [note: '사용자가 내용을 확인한 앱 내 알림']
  DISMISSED [note: '사용자가 목록에서 닫거나 숨긴 앱 내 알림']
  REVOKED [note: '접근 권한 취소 등으로 더 이상 유효하지 않은 앱 내 알림']
}

Enum notification_delivery_status {
  PENDING [note: '푸시 발송을 기다리는 기기 전달 작업']
  PROCESSING [note: '워커가 선점해 푸시 발송 중인 작업']
  SENT [note: '푸시 공급자가 발송 요청을 수락한 작업']
  FAILED [note: '재시도 가능한 푸시 발송 실패 작업']
  CANCELLED [note: '설정 변경 또는 권한 소멸로 취소한 전달 작업']
  DEAD [note: '최대 재시도를 초과해 중단한 전달 작업']
}

// -----------------------------------------------------------------------------
// 지역과 계정
// -----------------------------------------------------------------------------

Table region_code [headercolor: #4E79A7] {
  code varchar(100) [pk, not null, note: '서비스와 외부 지역 데이터가 공통으로 사용하는 지역 식별 코드']
  parent_code varchar(100) [note: '지역 계층에서 바로 위 부모 지역 코드이며 국가는 비어 있음']
  display_name text [not null, note: '화면에 표시할 지역 이름']
  level region_level [not null, note: '국가부터 세부 지역까지의 계층 단계']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']

  indexes {
    (code, level) [unique, name: 'uq_region_code_code_level', note: '국가 코드가 COUNTRY 행을 정확히 참조하도록 코드와 계층을 함께 유일하게 만든다. V9 migration에서 추가되었다']
    parent_code [name: 'region_code_parent_idx', note: 'SQL DDL은 parent_code IS NOT NULL인 partial index']
  }

  checks {
    `parent_code IS NULL OR parent_code <> code` [name: 'ck_region_code_not_self_parent']
    `btrim(display_name) <> ''` [name: 'ck_region_code_display_name']
    `(level = 'COUNTRY') = (parent_code IS NULL)` [name: 'ck_region_code_root']
  }

  Note: '테이블 설명: 국가부터 세부 지역까지의 계층과 화면 표시 이름을 관리하는 지역 코드 마스터 테이블이다. 필요 이유: 지역 문자열을 여러 테이블에 제각각 저장하지 않고 하나의 코드 체계로 통일해 위치 조회와 공개 지역 표현의 일관성을 지킨다.'
}

Table user_account [headercolor: #4E79A7] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  role user_role [not null, default: 'USER', note: '일반 사용자와 운영자를 구분하는 권한']
  status user_status [not null, default: 'ACTIVE', note: '현재 처리 상태']
  country_code varchar(2) [note: '온보딩에서 검증한 ISO 3166-1 alpha-2 국가 코드. USER는 필수이고 OPERATOR는 NULL을 허용한다']
  country_level varchar(20) [note: 'country_code가 region_code의 COUNTRY 행만 참조하도록 사용하는 생성 컬럼이며 항상 COUNTRY로 계산된다']
  coarse_region_code varchar(100) [not null, note: '사용자의 공개용 기준 지역 코드']
  locale varchar(35) [not null, note: '언어와 지역별 표시 형식을 결정하는 로케일']
  timezone varchar(64) [not null, note: '날짜 경계와 알림 계산에 사용하는 IANA 시간대']
  nickname varchar(50) [note: '다른 사용자에게 표시할 익명 닉네임']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']
  version bigint [not null, default: 0, note: 'JPA 낙관적 잠금용 행 버전. 수정마다 증가하며 동시 수정 중 뒤늦은 요청을 거절한다. V4 migration에서 추가되었다.']
  deleted_at timestamptz [note: '삭제 처리된 시각']

  indexes {
    (id, role) [unique, name: 'uq_user_account_id_role', note: 'id가 이미 PK지만 operator_credential의 (user_id, role) 복합 외래키가 참조하려면 그 컬럼 조합에 unique가 따로 있어야 한다. PostgreSQL의 요구사항이다. V5 migration에서 추가되었다']
    coarse_region_code [name: 'user_account_region_idx', note: 'region_code 삭제 시 RESTRICT 검사와 지역 단위 조회용 FK 인덱스']
    country_code [name: 'user_account_country_idx', note: '국가 단위 조회와 country_code 복합 FK의 역방향 검사에 사용한다. V9 migration에서 추가되었다']
  }

  checks {
    `nickname IS NULL OR btrim(nickname) <> ''` [name: 'ck_user_account_nickname']
    `(status = 'DELETED' AND deleted_at IS NOT NULL) OR (status <> 'DELETED' AND deleted_at IS NULL)` [name: 'ck_user_account_deleted_at']
    `country_code IS NULL OR country_code ~ '^[A-Z]{2}$'` [name: 'ck_user_account_country_code']
    `role <> 'USER' OR country_code IS NOT NULL` [name: 'ck_user_account_user_country']
  }

  Note: '테이블 설명: 사용자의 기본 식별자, 권한, 계정 상태, 기준 지역과 시간대를 관리하는 계정 테이블이다. 필요 이유: 사용자 식별자와 서비스 공통 권한·계정 상태를 한곳에서 관리해 모든 도메인이 동일한 계정 기준을 참조하게 한다.'
}

Table operator_credential [headercolor: #4E79A7] {
  user_id bigint [pk, not null, note: 'user_account를 가리키는 기본키이자 외래키']
  role user_role [not null, default: 'OPERATOR', note: 'user_account.role과 복합 외래키를 이루기 위한 사본. 항상 OPERATOR다.']
  login_id varchar(50) [not null, note: '백오피스 로그인 식별자. 소문자만 허용한다.']
  password_hash varchar(255) [not null, note: '검증된 비밀번호 해시. 평문은 저장하지 않는다.']
  failed_attempt_count smallint [not null, default: 0, note: '연속 로그인 실패 횟수. 성공하면 0으로 되돌린다.']
  locked_until timestamptz [note: '잠금이 풀리는 시각. 잠겨 있지 않으면 NULL이다.']
  password_updated_at timestamptz [not null, default: `clock_timestamp()`, note: '비밀번호 마지막 변경 시각. 초기 비밀번호 강제 변경 판단에 쓴다.']
  last_login_at timestamptz [note: '마지막 로그인 성공 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']

  indexes {
    login_id [unique, name: 'uq_operator_credential_login_id', note: '로그인 식별자는 계정 간 유일하다. CHECK가 소문자만 허용하므로 대소문자 차이로 같은 식별자가 둘 생기지 않는다']
  }

  checks {
    `role = 'OPERATOR'` [name: 'ck_operator_credential_role']
    `btrim(login_id) <> '' AND login_id = lower(login_id)` [name: 'ck_operator_credential_login_id']
    `failed_attempt_count >= 0` [name: 'ck_operator_credential_failed_attempt']
    `locked_until IS NULL OR locked_until > created_at` [name: 'ck_operator_credential_locked_until']
  }

  Note: '테이블 설명: 백오피스 운영자의 로그인 자격증명과 잠금 상태를 관리하는 테이블이다. 필요 이유: 계정 생명주기와 자격증명 생명주기의 변경 주기가 다르고, 일반 사용자가 운영자 때문에 존재하는 NULL 컬럼을 들고 다니지 않게 한다. (user_id, role) 복합 외래키로 USER 계정에 자격증명이 붙는 것을 DB가 거절한다. V5 migration에서 추가되었다.'
}

Table device_credential [headercolor: #4E79A7] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  user_id bigint [not null, note: '대상 사용자 식별자']
  installation_id varchar(64) [not null, note: '클라이언트가 만든 기기 식별자. 인증 수단이 아니라 조회·재등록 판단용 식별자일 뿐이다']
  secret_hash char(64) [not null, note: '서버가 발급한 device_secret의 SHA-256 해시(hex). 평문은 저장하지 않는다']
  platform device_platform [not null, note: '자격증명을 등록한 클라이언트 플랫폼']
  credential_status device_credential_status [not null, default: 'ACTIVE', note: '현재 인증 가능 여부']
  last_used_at timestamptz [not null, default: `clock_timestamp()`, note: '토큰 재발급이 성공할 때마다 갱신되는 마지막 사용 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  revoked_at timestamptz [note: '자격증명을 해지한 시각']

  indexes {
    secret_hash [unique, name: 'uq_device_credential_secret', note: 'SHA-256에는 salt가 없어 값 자체가 유일해야 하며, 토큰 재발급의 조회 경로이기도 하다']
    installation_id [unique, name: 'uq_active_device_installation', note: '주의: 무조건 unique가 아니다. SQL DDL은 credential_status=ACTIVE인 행에만 적용되는 partial unique index이므로 REVOKED 자격증명은 같은 installation_id를 여러 행 가질 수 있다']
    user_id [name: 'device_credential_user_idx', note: 'SQL DDL은 credential_status=ACTIVE인 partial index. 사용자별 활성 기기 조회와 user_account CASCADE 삭제용']
  }

  checks {
    `platform IN ('IOS', 'ANDROID')` [name: 'ck_device_credential_platform']
    `credential_status IN ('ACTIVE', 'REVOKED')` [name: 'ck_device_credential_status']
    `(credential_status = 'REVOKED') = (revoked_at IS NOT NULL)` [name: 'ck_device_credential_revoked_at']
    `btrim(installation_id) <> ''` [name: 'ck_device_credential_installation_id']
  }

  Note: '테이블 설명: 앱 사용자 기기별 인증 자격증명을 관리하는 테이블이다. 필요 이유: 클라이언트가 만든 installation_id를 인증 수단으로 쓰지 않고, 서버가 발급한 고엔트로피 device_secret의 해시로만 기기를 인증한다. push_device와 물리적으로 같은 기기를 가리키지만 발급·해지 주체가 우리이고 생명주기가 독립적이라 분리한다. V7 migration에서 추가되었다.'
}

Table user_private_attribute [headercolor: #4E79A7] {
  user_id bigint [pk, not null, note: '대상 사용자 식별자']
  gender gender [note: '사용자가 선택적으로 제공한 성별 값']
  age_band age_band [note: '생년월일 대신 최소한으로 저장하는 연령대 구간']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']

  Note: '테이블 설명: 사용자가 선택적으로 제공한 성별과 연령대 같은 민감 속성을 보관하는 1대1 확장 테이블이다. 필요 이유: 성별·연령대 같은 선택형 민감 정보를 일반 계정과 분리해 수집 승인, 접근 권한, 삭제 범위를 독립 관리한다. P10 승인 전 연령대는 수집하지 않는다.'
}

Table active_user_presence [headercolor: #4E79A7] {
  user_id bigint [pk, not null, note: '대상 사용자 식별자']
  position geography(Point,4326) [note: 'P06 1안 확정에 따라 실제 사용자 좌표를 담는 운영 컬럼이다. 거리와 방위 계산에 사용한다. SQL DDL은 이 컬럼에 partial GiST 인덱스 active_user_presence_position_gix(USING GIST ... WHERE receive_allowed)를 두어 방향·거리 후보 탐색을 가속한다. DBML은 GiST를 표현하지 못해 아래 인덱스 블록에 나타나지 않는다. 이 값은 API 응답·로그·분석 이벤트·Outbox payload에 넣지 않는다.']
  coarse_cell_id varchar(100) [note: '정확 좌표를 대체하지 않고 보조로 두는 공간 셀 식별자. P06 2안을 채택하지 않았으므로 선택 입력이다.']
  coarse_region_code varchar(100) [not null, note: '외부 응답에 노출하는 흐린 지역 코드']
  accuracy_m numeric(10,2) [note: '측정 위치의 예상 오차 반경 미터']
  receive_allowed boolean [not null, default: false, note: '현재 수신 후보에 포함할 수 있는지 여부']
  location_at timestamptz [not null, note: '위치가 실제 측정된 시각']
  expires_at timestamptz [not null, note: '이 위치를 후보 탐색에 쓰지 않을 시각']

  indexes {
    expires_at [name: 'active_user_presence_expiry_idx', note: 'SQL DDL은 receive_allowed=true인 partial index']
    coarse_region_code [name: 'active_user_presence_region_idx', note: 'region_code 삭제 시 RESTRICT 검사와 지역 단위 후보 조회용 FK 인덱스']
  }

  checks {
    `num_nonnulls(position, coarse_cell_id) >= 1` [name: 'ck_active_user_presence_location']
    `accuracy_m IS NULL OR accuracy_m >= 0` [name: 'ck_active_user_presence_accuracy']
    `expires_at > location_at` [name: 'ck_active_user_presence_expiry']
  }

  Note: '테이블 설명: 수신자 매칭에 사용할 사용자의 최근 위치와 수신 가능 여부를 TTL 형태로 보관하는 테이블이다. 필요 이유: 자주 바뀌고 짧게 유효한 위치와 수신 가능 상태를 계정 원본에서 분리해 TTL 기반 수신자 탐색을 빠르게 수행한다. P06 정책: 1안(짧은 TTL 정확 좌표 저장, 외부에는 흐린 값만 제공)으로 2026-08-03 확정했다. 이 테이블이 서비스 전체에서 정확 좌표를 보관하는 유일한 곳이며 접근 경로를 매칭 워커로 제한한다. 인덱스 보충: SQL DDL에는 아래 인덱스 블록 외에 position 컬럼의 partial GiST 인덱스 active_user_presence_position_gix(WHERE receive_allowed)가 있으며, 이것이 방향·거리 후보 탐색의 핵심 인덱스다.'
}

Table recipient_receive_state [headercolor: #4E79A7] {
  user_id bigint [pk, not null, note: '대상 사용자 식별자']
  active_unhandled_count smallint [not null, default: 0, note: '답변·넘기기·만료로 해제되지 않은 활성 수신 건수']
  recent_received_count integer [not null, default: 0, note: '공정한 수신자 선택에 사용하는 최근 수신 누적 건수']
  recent_window_started_at timestamptz [not null, default: `clock_timestamp()`, note: '최근 수신 건수 집계를 시작한 기준 시각']
  last_received_at timestamptz [note: '가장 최근에 수신 권한을 받은 시각']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']

  indexes {
    (active_unhandled_count, recent_received_count, last_received_at) [name: 'recipient_receive_selection_idx']
  }

  checks {
    `active_unhandled_count BETWEEN 0 AND 50` [name: 'ck_recipient_receive_state_active_count']
    `recent_received_count >= 0` [name: 'ck_recipient_receive_state_recent_count']
    `last_received_at IS NULL OR last_received_at >= recent_window_started_at` [name: 'ck_recipient_receive_state_last_received']
  }

  Note: '테이블 설명: 사용자별 활성 미처리 수신 건수와 최근 수신 이력을 집계한 용량 관리 테이블이다. 필요 이유: 활성 미처리 질문글이 설정된 수신 상한을 넘지 않도록 매칭 트랜잭션에서 원자적으로 예약해 동시 발송 시 초과를 막는다. 수신 상한: 고정 상수가 아니라 운영 설정값이다(초기값 5, 10 등으로 조정 가능). 실효 상한은 애플리케이션 설정에서 읽어 T5 예약 시 비교하며, 이 테이블의 CHECK는 어떤 설정에서도 넘을 수 없는 안전 상한 50만 강제한다. 상한을 DB CHECK로 박으면 값을 바꿀 때마다 마이그레이션이 필요해진다. ck_recipient_receive_state_active_count(2026-08-04): 이전의 BETWEEN 0 AND 5에서 상한 5 하드코딩을 제거하고 안전 상한 50으로 바꿨다. 슬롯 해제: 열람과 공감으로는 해제되지 않고 답변·넘김 확정·만료·참여 불가 전환으로만 해제된다.'
}

// -----------------------------------------------------------------------------
// 질문 제안, 승인 질문과 배정
// -----------------------------------------------------------------------------

Table question_proposal [headercolor: #59A14F] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  proposer_id bigint [not null, note: '질문을 제안한 사용자 식별자']
  status question_proposal_status [not null, default: 'DRAFT', note: '현재 처리 상태']
  proposed_text text [not null, note: '사용자가 제출한 질문 문구 원문']
  decision_reason text [note: '운영 판정 결과를 사용자에게 설명할 사유']
  submitted_at timestamptz [note: '사용자가 제출을 완료한 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']

  indexes {
    (status, updated_at) [name: 'question_proposal_review_queue_idx', note: 'SQL DDL은 SUBMITTED, UNDER_REVIEW만 포함하는 partial index. updated_at 정렬에 의존하므로 애플리케이션이 상태 변경 시 updated_at을 반드시 갱신해야 한다']
    proposer_id [name: 'question_proposal_proposer_idx', note: '제안자별 목록 조회와 FK RESTRICT 검사용']
  }

  checks {
    `btrim(proposed_text) <> ''` [name: 'ck_question_proposal_text']
    `status = 'DRAFT' OR submitted_at IS NOT NULL` [name: 'ck_question_proposal_submission']
  }

  Note: '테이블 설명: 사용자가 운영 검토를 요청한 질문 문구와 현재 처리 상태를 저장하는 테이블이다. 필요 이유: 사용자 제안을 승인 질문과 분리해 승인 전 비공개 원칙과 제안자의 처리 상태 조회를 보장한다. 트리거 불변식: SQL DDL의 tr_question_proposal_text_immutable_after_submit(BEFORE UPDATE OF proposed_text)이 DRAFT를 벗어난 제안의 문구 변경을 거부해, 운영자가 검토한 문구와 실제 문구가 달라지지 않는다.'
}

Table question_proposal_review [headercolor: #59A14F] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  proposal_id bigint [not null, note: '검토 대상 질문 제안 식별자']
  reviewer_id bigint [not null, note: '판정을 수행한 운영자 식별자']
  decision question_review_decision [not null, note: '승인 또는 반려 판정']
  reason text [note: '판정 근거이며 반려일 때 필수']
  reviewed_at timestamptz [not null, default: `clock_timestamp()`, note: '판정을 확정한 시각']

  indexes {
    (proposal_id, reviewed_at) [name: 'question_proposal_review_history_idx', note: 'SQL DDL은 reviewed_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
    reviewer_id [name: 'question_proposal_review_reviewer_idx', note: '운영자별 검토 이력 조회와 FK RESTRICT 검사용']
  }

  checks {
    `decision = 'APPROVED' OR NULLIF(btrim(reason), '') IS NOT NULL` [name: 'ck_question_proposal_review_reason']
  }

  Note: '테이블 설명: 운영자가 질문 제안을 승인하거나 반려한 판정과 사유를 기록하는 검토 이력 테이블이다. 필요 이유: 질문 제안 상태를 덮어쓰는 데 그치지 않고 누가 언제 어떤 이유로 승인·반려했는지 감사 이력으로 남긴다.'
}

Table approved_question [headercolor: #59A14F] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  source_proposal_id bigint [unique, note: '사용자 제안에서 승격된 경우 원본 제안 식별자. SQL DDL의 제약명은 uq_approved_question_source_proposal다']
  source_type approved_question_source_type [not null, note: '운영자·사용자 제안·자동 생성 중 질문 출처']
  status approved_question_status [not null, default: 'PENDING_REVIEW', note: '현재 처리 상태']
  question_text text [not null, note: '사용자에게 제시되는 변경 불가 질문 문구']
  answer_format answer_format [not null, note: '사진·글 등 질문이 안내하는 응답 형식']
  active_from timestamptz [note: '신규 배정 가능 시작 시각']
  active_until timestamptz [note: '신규 배정 중단 시각']
  approved_at timestamptz [note: '운영 승인이 확정된 시각']
  approved_by bigint [note: '승인을 수행한 운영자 식별자']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']

  indexes {
    (active_from, active_until) [name: 'approved_question_active_idx', note: 'SQL DDL은 status=ACTIVE인 partial index']
    approved_by [name: 'approved_question_approver_idx', note: 'SQL DDL은 approved_by IS NOT NULL인 partial index. 승인자별 조회와 FK RESTRICT 검사용']
  }

  checks {
    `(source_type = 'USER_PROPOSAL' AND source_proposal_id IS NOT NULL) OR (source_type <> 'USER_PROPOSAL' AND source_proposal_id IS NULL)` [name: 'ck_approved_question_source']
    `btrim(question_text) <> ''` [name: 'ck_approved_question_text']
    `active_until IS NULL OR active_from IS NULL OR active_until > active_from` [name: 'ck_approved_question_active_range']
    `status <> 'ACTIVE' OR (approved_at IS NOT NULL AND approved_by IS NOT NULL AND active_from IS NOT NULL)` [name: 'ck_approved_question_approval']
  }

  Note: '테이블 설명: 운영 검토를 통과해 사용자 배정과 방향 글 작성에 사용할 수 있는 질문 풀 테이블이다. 필요 이유: 검토를 통과한 질문만 배정과 글 작성에 사용하도록 질문 풀의 기준점을 제공하고 과거 콘텐츠가 참조한 문구를 보존한다. 트리거 불변식: SQL DDL의 tr_approved_question_text_immutable(BEFORE UPDATE OF question_text)이 승인 이후 question_text 변경을 거부해, 과거 방향 글이 참조한 문구가 사후에 바뀌지 않는다.'
}

Table question_assignment_cycle [headercolor: #59A14F] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  user_id bigint [not null, note: '대상 사용자 식별자']
  cycle_key varchar(100) [not null, note: '같은 사용자에게 같은 주기를 중복 생성하지 않는 멱등키']
  pool_version varchar(100) [not null, note: '배정 당시 승인 질문 풀의 스냅샷 버전']
  status question_assignment_cycle_status [not null, default: 'ACTIVE', note: '현재 처리 상태']
  starts_at timestamptz [not null, note: '질문 세트 유효 시작 시각']
  ends_at timestamptz [not null, note: '질문 세트 유효 종료 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']

  indexes {
    (user_id, cycle_key) [unique, name: 'uq_question_assignment_cycle_user_key']
  }

  checks {
    `ends_at > starts_at` [name: 'ck_question_assignment_cycle_range']
  }

  Note: '테이블 설명: 특정 사용자에게 일정 기간 유지되는 질문 세트의 주기와 풀 버전을 관리하는 테이블이다. 필요 이유: 한 주기 동안 같은 사용자에게 같은 질문 세트를 유지하고 배정 결과를 버전과 기간으로 재현한다.'
}

Table question_assignment [headercolor: #59A14F] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  cycle_id bigint [not null, note: '이 질문이 속한 사용자별 배정 주기']
  approved_question_id bigint [not null, note: '배정된 승인 질문 식별자']
  display_order integer [not null, note: '화면에 표시할 순서']
  assigned_at timestamptz [not null, default: `clock_timestamp()`, note: '질문이 주기에 포함된 시각']
  first_viewed_at timestamptz [note: '사용자가 질문을 처음 확인한 시각']
  used_at timestamptz [note: '이 질문으로 방향 글을 작성한 시각']

  indexes {
    (cycle_id, approved_question_id) [unique, name: 'uq_question_assignment_cycle_question']
    (cycle_id, display_order) [unique, name: 'uq_question_assignment_cycle_order']
    (approved_question_id, assigned_at) [name: 'question_assignment_history_idx', note: 'SQL DDL은 assigned_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
  }

  checks {
    `display_order > 0` [name: 'ck_question_assignment_display_order']
    `first_viewed_at IS NULL OR first_viewed_at >= assigned_at` [name: 'ck_question_assignment_viewed_at']
    `used_at IS NULL OR used_at >= assigned_at` [name: 'ck_question_assignment_used_at']
  }

  Note: '테이블 설명: 배정 주기 안에 포함된 승인 질문, 표시 순서, 노출과 사용 시각을 저장하는 테이블이다. 필요 이유: 배정 주기와 승인 질문의 다대다 관계, 화면 순서, 최초 노출과 사용 여부를 행 단위로 기록한다.'
}

// -----------------------------------------------------------------------------
// 방향 글, 수신 권한, 답변과 미디어
// -----------------------------------------------------------------------------

Table direction_scheme [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  code varchar(50) [not null, note: '같은 방향 정책 계열을 묶는 코드']
  version integer [not null, note: '정책 변경 순서를 나타내는 버전']
  type direction_scheme_type [not null, note: '동일 구간 분할 또는 연속 각도 방식']
  segment_count integer [note: '동일 분할 정책의 방향 구간 수']
  start_offset_deg numeric(7,3) [not null, note: '첫 구간 경계 계산의 시작 오프셋 각도']
  status direction_scheme_status [not null, default: 'ACTIVE', note: '현재 처리 상태']

  indexes {
    (code, version) [unique, name: 'uq_direction_scheme_code_version']
    code [unique, name: 'uq_direction_scheme_active', note: '주의: 실제 제약은 무조건 unique가 아니다. SQL DDL은 status=ACTIVE인 행에만 적용되는 partial unique index다. 같은 code의 두 버전이 동시에 ACTIVE가 되는 것을 막아 애플리케이션이 현재 방향 정책을 모호하지 않게 고를 수 있다. INACTIVE·ARCHIVED 버전은 code가 겹쳐도 된다']
  }

  checks {
    `version > 0` [name: 'ck_direction_scheme_version']
    `(type = 'EQUAL_SEGMENTS' AND segment_count > 0) OR (type = 'CONTINUOUS' AND segment_count IS NULL)` [name: 'ck_direction_scheme_segment_count']
    `start_offset_deg >= 0 AND start_offset_deg < 360` [name: 'ck_direction_scheme_start_offset']
  }

  Note: '테이블 설명: 방향 분할 방식, 구간 수, 시작 각도와 버전을 정의하는 방향 정책 마스터 테이블이다. 필요 이유: 방향 수와 분할 방식이 바뀌어도 정책을 버전 관리해 과거 발송을 새로운 규칙으로 재해석하지 않게 한다.'
}

Table direction_segment [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  scheme_id bigint [not null, note: '이 구간이 속한 방향 정책 버전']
  segment_key varchar(20) [not null, note: 'API와 클라이언트가 사용하는 구간 코드']
  display_name varchar(50) [not null, note: '화면에 표시할 방향 이름']
  center_bearing_deg numeric(7,3) [not null, note: '정북 0도 기준 구간 중심 방위각']
  angular_width_deg numeric(7,3) [not null, note: '구간이 차지하는 전체 각도 폭']
  sort_order integer [not null, note: '구간 정렬 순서']

  indexes {
    (scheme_id, segment_key) [unique, name: 'uq_direction_segment_key']
    (scheme_id, sort_order) [unique, name: 'uq_direction_segment_order']
  }

  checks {
    `center_bearing_deg >= 0 AND center_bearing_deg < 360` [name: 'ck_direction_segment_center']
    `angular_width_deg > 0 AND angular_width_deg <= 360` [name: 'ck_direction_segment_width']
    `sort_order >= 0` [name: 'ck_direction_segment_order']
  }

  Note: '테이블 설명: 방향 정책에 속한 각 구간의 코드, 이름, 중심 방위각과 각도 폭을 정의하는 테이블이다. 필요 이유: 방향 구간을 코드에 고정하지 않고 데이터로 관리해 방향 수, 이름, 중심각과 폭 변경을 지원한다.'
}

Table media_asset [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  owner_id bigint [not null, note: '소유 사용자 식별자']
  status media_asset_status [not null, default: 'UPLOADING', note: '현재 처리 상태']
  storage_key varchar(500) [not null, unique, note: '오브젝트 스토리지 내부 파일 키. SQL DDL의 제약명은 uq_media_asset_storage_key다']
  mime_type varchar(100) [not null, note: '파일 형식 검증에 사용하는 MIME 타입']
  byte_size bigint [not null, note: '업로드 제한과 비용 계산에 쓰는 파일 크기']
  checksum varchar(128) [not null, note: '무결성과 중복 확인에 쓰는 해시']
  exif_stripped boolean [not null, default: false, note: '사진 EXIF 민감 정보 제거 완료 여부']
  moderation_status content_moderation_status [not null, default: 'PENDING', note: '콘텐츠 안전 검사 결과']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  deleted_at timestamptz [note: '삭제 처리된 시각']

  indexes {
    (id, owner_id) [unique, name: 'uq_media_asset_id_owner']
    owner_id [name: 'media_asset_owner_idx', note: '소유자별 미디어 조회와 FK RESTRICT 검사용']
  }

  checks {
    `byte_size > 0` [name: 'ck_media_asset_size']
    `(status = 'DELETED') = (deleted_at IS NOT NULL)` [name: 'ck_media_asset_deleted_at']
  }

  Note: '테이블 설명: 업로드된 파일의 소유자, 저장 위치, 형식, 크기, 검사와 삭제 상태를 관리하는 미디어 테이블이다. 필요 이유: 파일 업로드·검사·삭제 생명주기를 콘텐츠에서 분리하고 소유자와 안전 검사 결과를 공통 관리한다. 트리거 불변식: SQL DDL의 ct_media_status_preserves_content(DEFERRABLE INITIALLY DEFERRED)가 status 변경으로 이 미디어가 붙은 ACTIVE 글이나 PUBLISHED 답변이 콘텐츠 없는 상태가 되는 것을 막는다. media_attachment.media_id가 PK이므로 이 트리거는 최대 한 건의 첨부만 확인한다.'
}

Table direction_post [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  sender_id bigint [not null, note: '방향 글을 작성하고 발송한 사용자']
  approved_question_id bigint [not null, note: '글 작성의 출발점이 된 승인 질문']
  status direction_post_status [not null, default: 'SUBMITTED', note: '현재 처리 상태']
  idempotency_key varchar(200) [not null, note: '동일 요청의 중복 처리를 막는 멱등키']
  body_text text [note: '사용자가 작성한 글 본문']
  coarse_region_code varchar(100) [not null, note: '글에 공개할 흐린 발송 지역']
  moderation_status content_moderation_status [not null, default: 'PENDING', note: '콘텐츠 안전 검사 결과']
  submitted_at timestamptz [not null, default: `clock_timestamp()`, note: '사용자가 제출을 완료한 시각']
  published_at timestamptz [note: '상대 사용자에게 공개된 시각']
  expires_at timestamptz [not null, note: '새 답변 작성을 차단할 만료 시각. 서버가 발송 시점에 확정하며 사용자가 고르지 않는다. 만료 후에도 질문자의 열람과 공감은 계속 가능하다']
  answers_read_at timestamptz [note: '질문자가 이 질문글의 답변 목록을 마지막으로 읽은 시각. 새로운 답변 n개 배지는 이 시각 이후 공개된 답변 수로 계산한다']
  deleted_at timestamptz [note: '삭제 처리된 시각']

  indexes {
    (sender_id, idempotency_key) [unique, name: 'uq_direction_post_idempotency']
    (id, sender_id) [unique, name: 'uq_direction_post_id_sender']
    (sender_id, submitted_at) [name: 'direction_post_sender_idx', note: 'SQL DDL은 submitted_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
    (expires_at, id) [name: 'direction_post_expiry_idx', note: 'SQL DDL은 MATCHING, ACTIVE인 partial index']
    approved_question_id [name: 'direction_post_question_idx', note: '질문별 발송 글 조회와 FK RESTRICT 검사용']
    coarse_region_code [name: 'direction_post_region_idx', note: 'region_code 삭제 시 RESTRICT 검사용 FK 인덱스']
  }

  checks {
    `body_text IS NULL OR btrim(body_text) <> ''` [name: 'ck_direction_post_body']
    `expires_at > submitted_at` [name: 'ck_direction_post_expiry']
    `status <> 'ACTIVE' OR published_at IS NOT NULL` [name: 'ck_direction_post_published_at']
    `(status = 'DELETED') = (deleted_at IS NOT NULL)` [name: 'ck_direction_post_deleted_at']
  }

  Note: '테이블 설명: 사용자가 승인 질문에 글이나 사진을 붙여 특정 방향으로 발송한 원문 콘텐츠 테이블이다. 필요 이유: 사용자가 승인 질문에 붙여 한 방향으로 보내는 원문 콘텐츠와 발행·검사·만료 상태의 기준 행을 제공한다. 트리거 불변식: SQL DDL의 ct_direction_post_question_active는 참조하는 approved_question의 status가 ACTIVE일 때만 INSERT와 approved_question_id 변경을 허용한다. ct_direction_post_has_content는 status=ACTIVE인 글에 body_text 또는 status=READY인 첨부 미디어가 최소 하나 있어야 커밋되게 한다. 둘 다 DEFERRABLE INITIALLY DEFERRED constraint trigger이므로 트랜잭션 커밋 시점에 검사한다.'
}

Table post_audience [headercolor: #F28E2B] {
  post_id bigint [pk, not null, note: '방향 글 식별자이며 1대1 스냅샷 기본키']
  direction_scheme_id bigint [not null, note: '발송 시 사용한 방향 정책 버전']
  selected_segment_key varchar(20) [not null, note: '사용자가 선택한 방향 구간 코드']
  center_bearing_deg numeric(7,3) [not null, note: '발송 당시 선택 구간 중심각']
  angular_width_deg numeric(7,3) [not null, note: '발송 당시 선택 구간 각도 폭']
  min_distance_m bigint [not null, note: '수신 후보 최소 거리 미터']
  max_distance_m bigint [not null, note: '수신 후보 최대 거리 미터']
  origin_position geography(Point,4326) [note: 'P06 1안 확정에 따라 실제 발송 원점 좌표를 담는 운영 컬럼이다. 거리·방위 계산에 사용하며 외부 응답에는 노출하지 않는다.']
  origin_cell_id varchar(100) [note: '정확 좌표를 대체하지 않고 보조로 두는 발송 원점 공간 셀. 선택 입력이다.']
  snapshotted_at timestamptz [not null, default: `clock_timestamp()`, note: '발송 조건을 확정한 시각']

  indexes {
    (direction_scheme_id, selected_segment_key) [name: 'post_audience_segment_idx', note: 'direction_segment 복합 FK의 RESTRICT 검사와 방향 구간별 집계용']
  }

  checks {
    `center_bearing_deg >= 0 AND center_bearing_deg < 360` [name: 'ck_post_audience_center']
    `angular_width_deg > 0 AND angular_width_deg <= 360` [name: 'ck_post_audience_width']
    `min_distance_m >= 0 AND max_distance_m > min_distance_m` [name: 'ck_post_audience_distance']
    `num_nonnulls(origin_position, origin_cell_id) >= 1` [name: 'ck_post_audience_origin']
  }

  Note: '테이블 설명: 방향 글 발송 당시 선택한 방향, 거리 범위와 발송 원점을 고정한 1대1 조건 스냅샷 테이블이다. 필요 이유: 발송 당시 방향·거리·원점을 스냅샷으로 고정해 이후 정책이나 위치가 바뀌어도 매칭 조건을 재현한다.'
}

Table media_attachment [headercolor: #F28E2B] {
  media_id bigint [pk, not null, note: '첨부한 미디어 식별자이며 이 테이블의 기본키다. PK가 곧 "한 미디어는 한 콘텐츠에만 붙는다"는 불변식이므로 별도 트리거 없이 동시 삽입에서도 성립한다.']
  owner_id bigint [not null, note: '콘텐츠 작성자와 미디어 소유자 일치 검증용 사용자 식별자']
  post_id bigint [note: '방향 글에 첨부한 경우 대상 글 식별자']
  answer_id bigint [note: '답변에 첨부한 경우 대상 답변 식별자']
  display_order integer [not null, note: '한 콘텐츠 안에서 화면에 표시할 순서']

  indexes {
    (post_id, display_order) [unique, name: 'uq_media_attachment_post_order', note: 'SQL DDL은 post_id IS NOT NULL인 partial unique index. 방향 글 첨부 조회의 FK 인덱스 역할도 겸한다']
    (answer_id, display_order) [unique, name: 'uq_media_attachment_answer_order', note: 'SQL DDL은 answer_id IS NOT NULL인 partial unique index. 답변 첨부 조회의 FK 인덱스 역할도 겸한다']
  }

  checks {
    `num_nonnulls(post_id, answer_id) = 1` [name: 'ck_media_attachment_exactly_one_target']
    `display_order >= 0` [name: 'ck_media_attachment_order']
  }

  Note: '테이블 설명: 미디어를 방향 글 또는 답변 중 정확히 하나에 연결하고 표시 순서를 관리하는 첨부 테이블이다. 필요 이유: 2026-08-03 이전에는 post_media와 answer_media 두 테이블로 나뉘어 있었고 "한 미디어는 한 콘텐츠에만"을 count 기반 constraint trigger로 검사했다. 그 방식은 서로의 미커밋 행을 볼 수 없는 두 트랜잭션이 같은 미디어를 각각 다른 콘텐츠에 붙일 때 둘 다 통과하는 구멍이 있었다. 한 테이블로 합치고 media_id를 PK로 두어 DB가 원자적으로 강제하도록 바꿨다. 소유권 불변식: (media_id, owner_id) → media_asset(id, owner_id) 복합 FK가 미디어 소유자를 고정하고, (post_id, owner_id) → direction_post(id, sender_id)와 (answer_id, owner_id) → answer(id, author_id) 복합 FK가 콘텐츠 작성자와의 일치를 강제한다. 뒤의 두 FK는 MATCH SIMPLE이므로 해당 대상 컬럼이 NULL이면 검사를 건너뛰고, 값이 있을 때만 owner_id 일치를 요구한다. 트리거 불변식: SQL DDL의 ct_media_attachment_preserves_content(DEFERRABLE INITIALLY DEFERRED)가 첨부를 붙이거나 떼어낸 뒤에도 ACTIVE 글과 PUBLISHED 답변의 콘텐츠 조건이 유지되는지 재검사한다.'
}

Table post_recipient [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  post_id bigint [not null, note: '수신자가 접근할 방향 글']
  recipient_id bigint [not null, note: '열람·답변 권한을 받은 사용자']
  status post_recipient_status [not null, default: 'AVAILABLE', note: '현재 처리 상태']
  distance_m bigint [not null, note: '2026-08-07 추가. 발송 원점에서 수신자까지의 정확한 거리(미터) 스냅샷. 카드에 정확 거리를 표시하기로 확정되면서 필요해졌다. 수신자 좌표는 active_user_presence에 TTL로만 남아 나중에 재계산할 수 없으므로 매칭 시점에 박는다. 근거리 하한(10km) 미만이면 이 값 대신 distance_band를 노출한다']
  distance_band varchar(50) [not null, note: '거리 구간. 2026-08-07 이전에는 정확 거리를 대신하는 유일한 노출 값이었으나, 이제는 근거리 하한 미만일 때 정확 거리 대신 노출하는 값이다. 하한 이상에서는 distance_m을 그대로 보여준다']
  matched_bearing_deg numeric(7,3) [not null, note: '발송 원점에서 수신자까지 계산한 방위각. 발신자 기준이며 매칭 판정의 근거다. 화면에 이 값을 그대로 보여주지 않는다 — 표시용은 inbound_bearing_deg다']
  inbound_bearing_deg numeric(7,3) [not null, note: '2026-08-07 추가. 수신자 위치를 원점으로 계산한 역방위 스냅샷이며, 목록과 카드에 표시하는 방향은 언제나 이 값에서 나온다. 발송자가 "동쪽으로" 보냈어도 받는 사람에게는 서쪽에서 온 글이라, matched_bearing_deg를 그대로 쓰면 방향이 뒤집혀 보인다. 구면에서 역방위는 +180°가 아니라 별도 계산이므로 매칭 시점에 스냅샷으로 박는다. 구간 키는 저장하지 않는다 — 라벨은 조회 시점에 현재 ACTIVE인 direction_scheme으로 파생시켜야 스킴이 8방향에서 16방향으로 바뀔 때 데이터 마이그레이션 없이 목록 전체가 재분류된다. 반대로 발신 측의 post_audience.selected_segment_key는 사용자의 의사 표시이자 매칭 근거라 구간 자체를 스냅샷한다. 이 비대칭은 의도된 것이다']
  matched_region_code varchar(100) [not null, note: '매칭 당시 수신자의 흐린 지역']
  matched_at timestamptz [not null, default: `clock_timestamp()`, note: '수신자로 최종 확정된 시각']
  discovered_at timestamptz [note: '수신 항목 존재를 처음 확인한 시각']
  opened_at timestamptz [note: '질문글을 처음 열람한 시각']
  answers_read_at timestamptz [note: '2026-08-07 추가. 이 수신자가 해당 질문글의 답변 목록을 마지막으로 확인한 시각이며 `새 답변 n개` 배지의 기준선이다. direction_post.answers_read_at은 질문자 전용이라 수신자에게 쓸 수 없다 — 답변이 수신 자격자 전원에게 공개되면서 사람마다 마지막으로 본 시점이 달라졌기 때문에 기준선도 사람마다 필요하다']
  skip_requested_at timestamptz [note: '넘김을 요청한 시각. 이 시각부터 되돌리기 시간 동안은 SKIP_PENDING이며 수신 용량을 해제하지 않는다. 되돌리면 NULL로 되돌아간다']
  skipped_at timestamptz [note: '넘김이 확정되어 되돌릴 수 없게 된 시각']
  capacity_released_at timestamptz [note: '활성 미처리 수신 용량을 반환한 시각']
  expired_at timestamptz [note: '만료로 수신 권한이 종료된 시각']
  blocked_at timestamptz [note: '차단 관계로 접근을 중단한 시각']

  indexes {
    (post_id, recipient_id) [unique, name: 'uq_post_recipient_post_user']
    (id, recipient_id) [unique, name: 'uq_post_recipient_id_user']
    (recipient_id, status, matched_at) [name: 'post_recipient_inbox_idx', note: 'SQL DDL은 matched_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
    (recipient_id, matched_at) [name: 'post_recipient_capacity_idx', note: 'SQL DDL은 capacity_released_at IS NULL인 partial index이며 matched_at DESC 정렬']
    matched_region_code [name: 'post_recipient_region_idx', note: 'region_code 삭제 시 RESTRICT 검사용 FK 인덱스']
  }

  checks {
    `matched_bearing_deg >= 0 AND matched_bearing_deg < 360` [name: 'ck_post_recipient_bearing']
    `inbound_bearing_deg >= 0 AND inbound_bearing_deg < 360` [name: 'ck_post_recipient_inbound_bearing']
    `distance_m >= 0` [name: 'ck_post_recipient_distance_m']
    `btrim(distance_band) <> ''` [name: 'ck_post_recipient_distance_band']
    `(discovered_at IS NULL OR discovered_at >= matched_at) AND (opened_at IS NULL OR opened_at >= matched_at) AND (answers_read_at IS NULL OR answers_read_at >= matched_at) AND (skip_requested_at IS NULL OR skip_requested_at >= matched_at) AND (skipped_at IS NULL OR skipped_at >= skip_requested_at) AND (capacity_released_at IS NULL OR capacity_released_at >= matched_at) AND (expired_at IS NULL OR expired_at >= matched_at) AND (blocked_at IS NULL OR blocked_at >= matched_at)` [name: 'ck_post_recipient_timestamps']
    `(status = 'SKIPPED') = (skipped_at IS NOT NULL) AND (status = 'EXPIRED') = (expired_at IS NOT NULL) AND (status = 'BLOCKED') = (blocked_at IS NOT NULL) AND (status <> 'DISCOVERED' OR discovered_at IS NOT NULL) AND (status <> 'OPENED' OR opened_at IS NOT NULL) AND (status <> 'AVAILABLE' OR (discovered_at IS NULL AND opened_at IS NULL))` [name: 'ck_post_recipient_status_timestamps']
    `(status = 'SKIP_PENDING') = (skip_requested_at IS NOT NULL AND skipped_at IS NULL) AND (skip_requested_at IS NOT NULL OR skipped_at IS NULL)` [name: 'ck_post_recipient_skip_pending']
  }

  Note: '테이블 설명: 방향 글별로 최종 선정된 수신자와 열람·답변 권한 및 처리 상태를 저장하는 테이블이다. 필요 이유: 매칭 결과를 실제 열람·답변 권한으로 고정해 매 조회마다 위치를 재계산하지 않고 수신 상태와 용량을 추적한다. 트리거 불변식: SQL DDL의 ct_post_recipient_not_sender(DEFERRABLE INITIALLY DEFERRED)가 direction_post.sender_id와 같은 사용자를 수신자로 넣는 것을 거부해, 발신자가 자기 글을 수신하지 못한다. ct_post_recipient_capacity_release(DEFERRABLE INITIALLY DEFERRED)는 status가 ANSWERED·SKIPPED·EXPIRED·BLOCKED인 것과 capacity_released_at이 채워진 것이 서로 동치임을 커밋 시점에 검사한다. 즉시 검사하는 CHECK가 아니라 지연 트리거인 이유는 T6·T6A·T6B가 상태 전이와 조건부 용량 해제를 같은 트랜잭션 안의 서로 다른 문장으로 수행하기 때문이다. 이 트리거는 NEW가 아니라 post_recipient를 다시 조회해 판정한다. 지연 AFTER ROW 트리거는 실행 시점만 커밋으로 미룰 뿐 전달받는 튜플은 자신을 큐에 넣은 문장 당시의 버전이라, NEW로 판정하면 해제 직전의 중간 상태를 보고 잘못 실패한다. 상태 대응: ck_post_recipient_status_timestamps는 SKIPPED·EXPIRED·BLOCKED를 각자의 타임스탬프와 동치로 묶고, DISCOVERED·OPENED에는 해당 타임스탬프를 요구하며, AVAILABLE에는 열람 흔적이 없어야 함을 강제한다. 2026-08-03 이전에는 이 테이블만 상태와 타임스탬프를 연결하는 제약이 없어 status=SKIPPED인데 skipped_at이 비어 있는 행이 허용됐다. 답변 격리 폐기(2026-08-07, ADR 0002): 답변이 수신 자격자 전원에게 공개되면서 이 테이블의 역할이 하나 늘었다. post_recipient는 이제 "이 질문글을 받을 권한"만이 아니라 "이 질문글의 답변을 열람할 권한"의 근거이기도 하다. 답변 공감 자격 판정(ct_answer_reaction_reactor_can_view)이 이 테이블을 조회한다. 다만 넘김·만료로 인한 자격 상실은 시간에 따라 변하므로 그 트리거는 "수신자 집합에 속하는가"까지만 보고, 현재 열람 가능 여부는 조회 계층이 강제한다. 두 카테고리(2026-08-07): 화면의 `답변 안 한`/`답변한` 구분은 새 컬럼 없이 answer 존재 여부로 유도한다. 상태 기계는 바뀌지 않았고 바뀐 것은 그 상태를 어느 목록에 태우느냐뿐이다. 슬롯도 그대로다 — ANSWERED가 여전히 용량 해제 대상이고, 다만 해제 후에도 행이 화면에 남을 뿐이다. 넘김 되돌리기(2026-08-04): 넘김은 곧바로 SKIPPED가 되지 않고 SKIP_PENDING을 거친다. ct_post_recipient_capacity_release는 ANSWERED·SKIPPED·EXPIRED·BLOCKED만 용량 해제와 동치로 보므로, SKIP_PENDING은 트리거를 고치지 않고도 자연스럽게 용량을 붙잡아 둔다. 되돌리기 시간이 지나면 SKIP_CONFIRMATION_DUE 이벤트를 처리하는 워커가 SKIPPED로 확정하며 이때 용량이 해제된다. 되돌리면 skip_requested_at을 비우고 이전 상태로 되돌아가는데, 이전 상태는 별도 컬럼 없이 opened_at·discovered_at 유무로 유도한다 — opened_at이 있으면 OPENED, discovered_at만 있으면 DISCOVERED, 둘 다 없으면 AVAILABLE이다. ck_post_recipient_skip_pending은 SKIP_PENDING이 "넘김을 요청했지만 아직 확정되지 않은" 상태와 동치임을 강제한다. 확정된 넘김은 skip_requested_at과 skipped_at을 모두 가지고, 되돌린 넘김은 둘 다 비운다. ck_post_recipient_timestamps에서 skipped_at의 하한은 matched_at이 아니라 skip_requested_at이다. 확정은 요청보다 앞설 수 없다.'
}

Table answer [headercolor: #F28E2B] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  post_recipient_id bigint [not null, note: '답변 권한의 근거가 되는 수신 권한']
  author_id bigint [not null, note: '답변을 작성한 수신 사용자']
  status answer_status [not null, default: 'SUBMITTED', note: '현재 처리 상태']
  idempotency_key varchar(200) [not null, note: '동일 요청의 중복 처리를 막는 멱등키']
  body_text text [note: '사용자가 작성한 글 본문']
  coarse_region_code varchar(100) [not null, note: '정확 위치 대신 사용하는 흐린 지역 코드']
  bearing_from_sender_deg numeric(7,3) [not null, note: '질문자 원점에서 답변자까지의 방위각 스냅샷. 답변 옆에 표시하는 방향이 이 값이며, 보는 사람이 질문자든 다른 수신자든 같은 값을 본다. 보는 사람마다 다시 계산하지 않는다 — 그렇게 하면 답변 하나가 관측자마다 다른 방위를 갖게 되어 여러 관측을 모아 답변자 위치를 삼각측량할 수 있다. post_recipient.matched_bearing_deg와 같은 값이어야 한다']
  distance_m bigint [not null, note: '2026-08-07 추가. 질문자에서 답변자까지의 정확한 거리(미터) 스냅샷. 답변 옆에 표시하며 방위와 마찬가지로 질문자 기준 고정값이다. post_recipient.distance_m과 같은 값이어야 한다. 근거리 하한(10km) 미만이면 이 값 대신 distance_band를 노출한다']
  distance_band varchar(50) [not null, note: '거리 구간. 근거리 하한 미만일 때 정확 거리 대신 노출한다']
  moderation_status content_moderation_status [not null, default: 'PENDING', note: '현재 공개 중인 본문의 안전 검사 결과']
  submitted_at timestamptz [not null, default: `clock_timestamp()`, note: '사용자가 제출을 완료한 시각']
  published_at timestamptz [note: '다른 사용자에게 공개된 시각']
  edited_at timestamptz [note: '2026-08-07 추가. 수정된 내용이 검토를 통과해 실제로 반영된 시각이며, 값이 있으면 화면에 `수정됨`을 표시한다. 답변 수정이 허용되면서 필요해졌다. 재검토 큐에 넣을 근거이자, 신고가 들어왔을 때 신고 시점의 내용을 특정하는 기준이다. 공감은 수정해도 승계되므로 이 표시가 공감을 누른 사람에게 남기는 유일한 신호다']
  edit_count integer [not null, default: 0, note: '2026-08-07 추가. 검토를 통과해 실제로 반영된 수정 횟수다. 거절된 수정은 세지 않는다 — 반영되지 않았으므로 사용자가 얻은 것이 없다. 제한이 필요한 이유는 공감이 수정에도 승계되기 때문이다. 무제한이면 공감을 모은 뒤 내용을 반복해서 갈아끼우는 것이 사고가 아니라 기능이 되고, 수정마다 재검토가 돌아가 모더레이션 큐 비용도 그대로 늘어난다. 실효 상한은 초기값 3이지만 recipient_receive_state의 수신 상한과 같은 방식으로 운영 설정값이며, DB에는 폭주를 막는 안전 상한 10만 둔다. 수정 제출 시점 제한(만료 전까지)은 시간에 따라 판정이 변하므로 DB가 아니라 쓰기 계층에서 강제한다']
  deleted_at timestamptz [note: '삭제 처리된 시각']

  indexes {
    (author_id, idempotency_key) [unique, name: 'uq_answer_idempotency']
    (id, author_id) [unique, name: 'uq_answer_id_author']
    (post_recipient_id, published_at) [name: 'answer_recipient_idx', note: 'SQL DDL은 published_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
    post_recipient_id [unique, name: 'uq_answer_one_per_recipient', note: '2026-08-04 추가, 2026-08-07 조건 축소. 한 질문글에 답변은 1회다. SQL DDL은 status <> REJECTED인 partial unique다. 원래는 status NOT IN (REJECTED, DELETED)라 삭제하면 자리가 비어 다시 쓸 수 있었는데, "삭제 후 재작성 불가"가 확정되면서 DELETED를 제외 목록에서 뺐다. 열어두면 삭제→재작성이 사실상 무제한 수정이 되어 수정 정책(검토를 통과해야 반영)이 무의미해진다. REJECTED만 자리를 비켜주는 이유는 운영이 거절한 것은 사용자 잘못이 아니라 다시 쓸 기회를 줘야 하기 때문이다']
    coarse_region_code [name: 'answer_region_idx', note: 'region_code 삭제 시 RESTRICT 검사용 FK 인덱스']
  }

  checks {
    `body_text IS NULL OR btrim(body_text) <> ''` [name: 'ck_answer_body']
    `bearing_from_sender_deg >= 0 AND bearing_from_sender_deg < 360` [name: 'ck_answer_bearing']
    `distance_m >= 0` [name: 'ck_answer_distance_m']
    `btrim(distance_band) <> ''` [name: 'ck_answer_distance_band']
    `status <> 'PUBLISHED' OR published_at IS NOT NULL` [name: 'ck_answer_published_at']
    `edited_at IS NULL OR (published_at IS NOT NULL AND edited_at >= published_at)` [name: 'ck_answer_edited_at']
    `edit_count >= 0 AND edit_count <= 10` [name: 'ck_answer_edit_count']
    `(edit_count = 0) = (edited_at IS NULL)` [name: 'ck_answer_edit_count_matches_edited_at']
    `(status = 'DELETED') = (deleted_at IS NOT NULL)` [name: 'ck_answer_deleted_at']
  }

  Note: '테이블 설명: 방향 글 수신자가 작성한 글·사진 답변과 검사·공개·삭제 상태를 관리하는 테이블이다. 필요 이유: 수신 권한을 가진 사용자만 응답하게 하고 답변의 검사·공개·삭제와 멱등 제출을 독립 관리한다. 트리거 불변식: SQL DDL의 ct_answer_has_content(DEFERRABLE INITIALLY DEFERRED)가 status=PUBLISHED인 답변에 body_text 또는 status=READY인 첨부 미디어가 최소 하나 있어야 커밋되게 한다. 답변 개수(2026-08-04 확정): 한 질문글에 답변은 1회다. uq_answer_one_per_recipient partial unique가 강제하며, 이전의 "상한 미확정" 서술은 폐기했다. 열람 범위(2026-08-07 개정, ADR 0002): 답변을 조회할 수 있는 주체는 질문글 작성자와 그 질문글의 수신 자격자다. 이전 판은 질문자와 답변 작성자 본인뿐이었으나 답변 격리가 폐기됐다. 수신 자격이 없는 사용자에게는 답변 내용도 개수도 노출하지 않으며, 넘겼거나(SKIPPED) 답변 없이 만료된 수신자는 열람 자격을 잃는다. 이 판정은 상태에 따라 시간이 지나며 변하므로 DB 제약이 아니라 조회 계층에서 강제한다. 수정(2026-08-07): 작성자는 자기 답변의 텍스트와 사진을 수정할 수 있고 수정은 모더레이션 재검토를 거친 뒤 반영된다. 검토 중인 답변은 다른 사람에게 감추므로 대기 중인 본문을 따로 보관할 컬럼이 필요 없다 — status를 SAFETY_CHECKING으로 되돌리고 moderation_status를 PENDING으로 두면 조회 계층이 PUBLISHED만 노출하는 것으로 충분하다. 그 동안 body_text와 media_attachment를 직접 교체해도 중간 상태가 노출되지 않으며, ct_media_attachment_preserves_content와 ct_answer_has_content가 PUBLISHED만 검사하므로 교체 중간에 첨부가 비어도 통과한다. 반대로 검토 중에 기존 내용을 계속 보여주는 방식은 대기 중인 미디어를 붙일 대상이 media_attachment에 없어 텍스트 수정만 가능해진다. 작성자 본인에게는 검토 중에도 노출하고 `검토 중` 배지를 붙인다. 만료 후에 검토가 끝나도 반영한다 — 만료는 새 answer 행 생성만 막지 기존 행의 상태 전이를 막지 않는다. uq_answer_one_per_recipient가 SAFETY_CHECKING도 자리로 세므로 수정 중에 새 답변을 끼워 넣을 수 없다. 삭제: 흔적을 남기지 않으며 그 답변에 달린 answer_reaction은 FK CASCADE로 함께 사라진다. 삭제 후 같은 질문글에 다시 답변할 수 없다.'
}

Table post_reaction [headercolor: #F28E2B] {
  post_id bigint [not null, note: '공감을 받은 질문글']
  reactor_id bigint [not null, note: '공감을 남긴 수신자']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '공감을 남긴 시각']

  indexes {
    (post_id, reactor_id) [pk, name: 'pk_post_reaction']
    reactor_id [name: 'post_reaction_reactor_idx', note: '사용자 삭제 시 CASCADE 검사와 내 공감 조회용']
  }

  Note: '테이블 설명: 질문글에 남긴 공감(화면 문구 좋아요)을 기록하는 테이블이다. 필요 이유: 답변은 부담스럽지만 반응은 하고 싶은 수신자에게 유일한 저비용 표현 수단을 제공한다. 누를 수 있는 사람: (post_id, reactor_id) 복합 FK가 post_recipient(post_id, recipient_id)를 참조하므로, 수신 자격이 있는 사용자만 공감할 수 있다는 규칙이 별도 트리거 없이 키로 성립한다. 질문글 작성자는 자기 글의 수신자가 될 수 없으므로(ct_post_recipient_not_sender) 자기 글에 공감하는 경로도 함께 막힌다. 열람(2026-08-07 개정, ADR 0002): 공감 수는 그 질문글을 볼 수 있는 사람 전원(질문자 + 수신 자격자)에게 노출한다. 8/4 판까지는 질문자에게만 노출하고 받은 사람 화면에는 내가 눌렀는지 여부만 보여줬으나, 답변 열람이 전원 공개로 바뀌면서 이 규칙도 함께 뒤집혔다. 2026-08-08 정정: 이 Note가 그 변화를 놓치고 "질문자에게만 노출"로 남아 있던 것을 뒤늦게 발견해 고쳤다 — 아래 "스키마를 바꾸지 않아도 되는 것" 목록의 post_reaction 항목도 함께 참고. 슬롯: 공감은 수신 용량을 해제하지 않는다. 답변을 한 것이 아니기 때문이다. 취소: 다시 누르면 행을 삭제한다. 상태 컬럼을 두지 않는 이유는 취소 이력을 보관할 제품 요구가 없기 때문이다.'
}

Table answer_reaction [headercolor: #F28E2B] {
  answer_id bigint [pk, not null, note: '공감을 받은 답변']
  reactor_id bigint [pk, not null, note: '공감을 남긴 사용자. 그 질문글의 작성자이거나 수신 자격자여야 하며, 자기 답변에는 누를 수 없다']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '공감을 남긴 시각. 만료 뒤에 처음 열어보는 경우가 있어 답변 시각보다 한참 늦을 수 있다']

  indexes {
    reactor_id [name: 'answer_reaction_reactor_idx', note: '사용자 삭제 시 CASCADE 검사용 FK 인덱스']
  }

  Note: '테이블 설명: 답변에 남긴 공감을 기록하는 테이블이다. 필요 이유: 답변자가 받는 유일한 반응 신호이며, 이것이 없으면 답변자는 자기 답변이 읽혔는지조차 알 수 없다. 사용자당 1건: (answer_id, reactor_id) 복합 기본키로 "한 사람은 한 답변에 한 번만"이 키로 성립한다. 2026-08-07 변경: answer_id 단독 기본키였다. 공감할 수 있는 사람이 질문자 한 명뿐이라는 전제로 걸었던 키인데, ADR 0002로 답변이 수신 자격자 전원에게 공개되면서 두 번째 사람의 공감이 기본키 충돌로 실패하게 되어 복합 키로 바꿨다. 누를 수 있는 사람: reactor_id가 그 답변이 달린 질문글의 sender_id이거나 그 질문글의 post_recipient여야 하고, answer.author_id와 같아서는 안 된다(자기 답변 공감 금지). answer는 post_id를 직접 갖지 않고 post_recipient를 거쳐 도달하므로 복합 FK로는 표현할 수 없어 SQL DDL의 ct_answer_reaction_reactor_can_view constraint trigger가 강제한다. 만료 후: 만료된 질문글의 답변에도 공감할 수 있다. 만료는 새 답변만 차단한다. 알림: 이 행이 생기면 ANSWER_REACTED Outbox 이벤트를 발행해 답변자에게 알린다. 누가 눌렀는지는 알리지 않는다. 되보내기 없음: 답변에 줄 수 있는 것은 이 공감 하나이며 텍스트를 되보내는 통로는 만들지 않는다.'
}

// -----------------------------------------------------------------------------
// 차단, 신고와 운영 검토
// -----------------------------------------------------------------------------

Table user_block [headercolor: #E15759] {
  blocker_id bigint [not null, note: '차단을 실행한 사용자 식별자']
  blocked_id bigint [not null, note: '차단 대상 사용자 식별자']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  released_at timestamptz [note: '차단 해제 시각이며 비어 있으면 현재 차단 중']

  indexes {
    (blocker_id, blocked_id) [pk, name: 'pk_user_block']
    (blocked_id, blocker_id) [name: 'user_block_reverse_idx', note: 'SQL DDL은 released_at IS NULL인 partial index']
  }

  checks {
    `blocker_id <> blocked_id` [name: 'ck_user_block_not_self']
    `released_at IS NULL OR released_at >= created_at` [name: 'ck_user_block_release']
  }

  Note: '테이블 설명: 차단한 사용자와 차단된 사용자 쌍, 차단 시작과 해제 시각을 관리하는 관계 테이블이다. 필요 이유: 현재 차단 관계를 매칭·조회·알림에서 공통 확인해 차단한 사용자가 다시 연결되는 것을 막는다.'
}

Table report [headercolor: #E15759] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  reporter_id bigint [not null, note: '신고를 제출한 사용자']
  target_user_id bigint [note: '사용자를 신고한 경우 대상 사용자']
  direction_post_id bigint [note: '방향 글을 신고한 경우 대상 글']
  answer_id bigint [note: '답변을 신고한 경우 대상 답변']
  reason_code varchar(50) [not null, note: '신고 사유 분류 코드']
  detail text [note: '신고자가 작성한 상세 설명']
  status report_status [not null, default: 'RECEIVED', note: '현재 처리 상태']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  resolved_at timestamptz [note: '운영 판정이 끝난 시각']

  indexes {
    (reporter_id, target_user_id) [unique, name: 'uq_open_report_user', note: '주의: 실제 제약은 무조건 unique가 아니다. SQL DDL은 target_user_id IS NOT NULL이고 status IN (RECEIVED, AUTO_HIDDEN, UNDER_REVIEW)인 행에만 적용되는 partial unique index이므로, 신고가 종결되면 같은 사용자를 다시 신고할 수 있다']
    (reporter_id, direction_post_id) [unique, name: 'uq_open_report_post', note: '주의: 실제 제약은 무조건 unique가 아니다. SQL DDL은 direction_post_id IS NOT NULL이고 status IN (RECEIVED, AUTO_HIDDEN, UNDER_REVIEW)인 행에만 적용되는 partial unique index이므로, 신고가 종결되면 같은 글을 다시 신고할 수 있다']
    (reporter_id, answer_id) [unique, name: 'uq_open_report_answer', note: '주의: 실제 제약은 무조건 unique가 아니다. SQL DDL은 answer_id IS NOT NULL이고 status IN (RECEIVED, AUTO_HIDDEN, UNDER_REVIEW)인 행에만 적용되는 partial unique index이므로, 신고가 종결되면 같은 답변을 다시 신고할 수 있다']
    (status, created_at) [name: 'report_queue_idx', note: '운영 검토 대기열 조회용. SQL DDL은 RECEIVED, AUTO_HIDDEN, UNDER_REVIEW인 partial index']
    target_user_id [name: 'report_target_user_idx', note: 'SQL DDL은 target_user_id IS NOT NULL인 partial index. 대상별 누적 신고 조회와 FK RESTRICT 검사용']
    direction_post_id [name: 'report_direction_post_idx', note: 'SQL DDL은 direction_post_id IS NOT NULL인 partial index. 대상별 누적 신고 조회와 FK RESTRICT 검사용']
    answer_id [name: 'report_answer_idx', note: 'SQL DDL은 answer_id IS NOT NULL인 partial index. 대상별 누적 신고 조회와 FK RESTRICT 검사용']
  }

  checks {
    `num_nonnulls(target_user_id, direction_post_id, answer_id) = 1` [name: 'ck_report_exactly_one_target']
    `btrim(reason_code) <> ''` [name: 'ck_report_reason']
    `resolved_at IS NULL OR resolved_at >= created_at` [name: 'ck_report_resolution']
  }

  Note: '테이블 설명: 사용자, 방향 글 또는 답변에 대해 접수된 신고 대상·사유·처리 상태를 관리하는 테이블이다. 필요 이유: 사용자·방향 글·답변 중 하나에 대한 신고를 사건 단위로 접수하고 상태와 중복 미해결 신고를 관리한다.'
}

Table moderation_review [headercolor: #E15759] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  report_id bigint [not null, note: '판정 대상 신고 사건']
  reviewer_id bigint [not null, note: '검토를 수행한 운영자']
  decision moderation_review_decision [not null, note: '위반 조치·위반 없음·추가 정보 필요 판정']
  action_type varchar(50) [not null, note: '숨김·계정 제한 등 실제 조치 코드']
  internal_note text [note: '사용자에게 공개하지 않는 내부 메모']
  reviewed_at timestamptz [not null, default: `clock_timestamp()`, note: '운영 판정을 확정한 시각']

  indexes {
    (report_id, reviewed_at) [name: 'moderation_review_report_idx', note: 'SQL DDL은 reviewed_at DESC 정렬. 신고별 판정 이력 조회와 FK RESTRICT 검사용']
    reviewer_id [name: 'moderation_review_reviewer_idx', note: '운영자별 판정 이력 조회와 FK RESTRICT 검사용']
  }

  checks {
    `btrim(action_type) <> ''` [name: 'ck_moderation_review_action_type']
  }

  Note: '테이블 설명: 신고 사건에 대한 운영자의 판정, 실제 조치와 내부 메모를 기록하는 검토 이력 테이블이다. 필요 이유: 신고 상태와 별도로 운영자의 판정·조치 이력을 남겨 변경 과정과 책임자를 감사할 수 있게 한다.'
}

// -----------------------------------------------------------------------------
// 알림과 Outbox
// -----------------------------------------------------------------------------

Table push_device [headercolor: #B07AA1] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  user_id bigint [not null, note: '대상 사용자 식별자']
  platform push_platform [not null, note: 'iOS 또는 Android 푸시 공급자 구분']
  token_ciphertext bytea [not null, note: '암호화해 저장한 푸시 토큰 원문']
  token_fingerprint varchar(128) [not null, note: '복호화 없이 중복을 확인하는 토큰 지문']
  device_status push_device_status [not null, default: 'ACTIVE', note: '현재 발송 가능·무효·철회 상태']
  last_seen_at timestamptz [not null, default: `clock_timestamp()`, note: '앱이 토큰을 마지막으로 확인한 시각']
  revoked_at timestamptz [note: '토큰 사용을 철회한 시각']

  indexes {
    token_fingerprint [unique, name: 'uq_active_push_token', note: '주의: 실제 제약은 무조건 unique가 아니다. SQL DDL은 device_status=ACTIVE인 행에만 적용되는 partial unique index이므로, INVALID·REVOKED 기기는 같은 지문을 여러 행 가질 수 있다']
    user_id [name: 'push_device_user_idx', note: 'SQL DDL은 device_status=ACTIVE인 partial index. 사용자별 발송 대상 기기 조회와 user_account CASCADE 삭제용']
  }

  checks {
    `(device_status = 'REVOKED') = (revoked_at IS NOT NULL)` [name: 'ck_push_device_revoked_at']
  }

  Note: '테이블 설명: 사용자 기기별 플랫폼, 암호화된 푸시 토큰과 토큰 유효 상태를 관리하는 테이블이다. 필요 이유: 한 사용자의 여러 기기 토큰과 유효성·철회 상태를 분리해 기기별 푸시 대상을 관리한다.'
}

Table notification_preference [headercolor: #B07AA1] {
  notification_type notification_type [not null, note: '사용자가 설정하는 알림 종류']
  user_id bigint [not null, note: '대상 사용자 식별자']
  enabled boolean [not null, default: true, note: '외부 알림 수신 허용 여부']
  quiet_start time [note: '푸시를 즉시 보내지 않을 시간대 시작']
  quiet_end time [note: '조용한 시간대 종료']
  updated_at timestamptz [not null, default: `clock_timestamp()`, note: '마지막으로 변경된 시각']

  indexes {
    (notification_type, user_id) [pk, name: 'pk_notification_preference']
    user_id [name: 'notification_preference_user_idx', note: 'PK의 선두 컬럼이 notification_type이라 user_id 단독 조회를 커버하지 못한다. 사용자별 설정 일괄 조회와 CASCADE 삭제용']
  }

  checks {
    `num_nonnulls(quiet_start, quiet_end) IN (0, 2)` [name: 'ck_notification_preference_quiet_hours']
  }

  Note: '테이블 설명: 사용자별 알림 종류 수신 여부와 조용한 시간대를 관리하는 설정 테이블이다. 필요 이유: 사용자가 알림 종류별 수신 여부와 조용한 시간대를 독립적으로 설정하게 한다.'
}

Table outbox_event [headercolor: #B07AA1] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  aggregate_type outbox_aggregate_type [not null, note: '이벤트가 발생한 도메인 주체 종류']
  aggregate_id bigint [not null, note: '이벤트가 발생한 도메인 주체 식별자']
  event_type outbox_event_type [not null, note: '워커가 수행할 후속 작업 종류']
  dedup_key varchar(255) [not null, unique, note: '같은 논리 이벤트의 중복을 막는 키. SQL DDL의 제약명은 uq_outbox_event_dedup다']
  payload jsonb [not null, default: `'{}'::jsonb`, note: '후속 처리에 사용할 JSON 스냅샷']
  status outbox_status [not null, default: 'PENDING', note: '현재 처리 상태']
  attempt_count integer [not null, default: 0, note: '처리를 시도한 누적 횟수']
  next_attempt_at timestamptz [not null, default: `clock_timestamp()`, note: '실패 후 다시 처리할 수 있는 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  processed_at timestamptz [note: '후속 처리가 완료된 시각']

  indexes {
    (status, next_attempt_at, id) [name: 'outbox_event_dispatch_idx', note: 'SQL DDL은 PENDING, FAILED인 partial index']
  }

  checks {
    `jsonb_typeof(payload) = 'object'` [name: 'ck_outbox_event_payload']
    `attempt_count >= 0` [name: 'ck_outbox_event_attempt_count']
    `(status = 'PROCESSED') = (processed_at IS NOT NULL) AND (processed_at IS NULL OR processed_at >= created_at)` [name: 'ck_outbox_event_processed_at']
  }

  Note: '테이블 설명: 도메인 트랜잭션에서 발생한 비동기 후속 작업을 안전하게 전달하기 위한 이벤트 테이블이다. 필요 이유: 도메인 변경과 비동기 작업 요청을 같은 트랜잭션에 저장해 커밋 후 매칭·알림 이벤트가 유실되는 문제를 막는다.'
}

Table notification [headercolor: #B07AA1] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  recipient_id bigint [not null, note: '알림을 확인할 사용자']
  outbox_event_id bigint [not null, note: '알림 생성을 유발한 Outbox 이벤트']
  notification_type notification_type [not null, note: '화면 문구와 이동 목적지를 결정하는 종류']
  dedup_key varchar(255) [not null, note: '같은 사용자에게 동일 알림이 중복 생성되는 것을 막는 키']
  direction_post_id bigint [note: '방향 글 관련 알림의 이동 대상']
  answer_id bigint [note: '답변 관련 알림의 이동 대상']
  status notification_status [not null, default: 'UNREAD', note: '현재 처리 상태']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  read_at timestamptz [note: '사용자가 알림을 확인한 시각']

  indexes {
    (recipient_id, dedup_key) [unique, name: 'uq_notification_recipient_dedup']
    (recipient_id, read_at, created_at) [name: 'notification_inbox_idx', note: 'SQL DDL은 created_at DESC 정렬이며 DBML은 컬럼 정렬 방향을 표현하지 않는다']
    outbox_event_id [name: 'notification_outbox_idx', note: 'Outbox 이벤트별 생성 알림 추적과 FK RESTRICT 검사용']
    direction_post_id [name: 'notification_post_idx', note: 'SQL DDL은 direction_post_id IS NOT NULL인 partial index. direction_post 삭제 시 SET NULL 갱신 대상을 찾는 데 필요하다']
    answer_id [name: 'notification_answer_idx', note: 'SQL DDL은 answer_id IS NOT NULL인 partial index. answer 삭제 시 SET NULL 갱신 대상을 찾는 데 필요하다']
  }

  checks {
    `num_nonnulls(direction_post_id, answer_id) <= 1` [name: 'ck_notification_target']
    `read_at IS NULL OR (read_at >= created_at AND status IN ('READ', 'DISMISSED'))` [name: 'ck_notification_read_at']
  }

  Note: '테이블 설명: 사용자에게 노출되는 앱 내 알림의 종류, 이동 대상, 읽음 상태를 관리하는 테이블이다. 필요 이유: 푸시 성공 여부와 무관한 앱 내 알림의 진실의 원천을 제공하고 사용자별 중복 생성을 막는다.'
}

Table notification_delivery [headercolor: #B07AA1] {
  id bigint [pk, increment, not null, note: '행을 식별하는 기본키']
  notification_id bigint [not null, note: '푸시로 전달할 앱 내 알림']
  push_device_id bigint [not null, note: '발송을 시도할 대상 기기']
  status notification_delivery_status [not null, default: 'PENDING', note: '현재 처리 상태']
  attempt_count integer [not null, default: 0, note: '처리를 시도한 누적 횟수']
  next_attempt_at timestamptz [not null, default: `clock_timestamp()`, note: '실패 후 다시 처리할 수 있는 시각']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: '행이 생성된 시각']
  sent_at timestamptz [note: '푸시 공급자가 요청을 수락한 시각']
  provider_message_id varchar(255) [note: '푸시 공급자가 반환한 추적 메시지 식별자']

  indexes {
    (notification_id, push_device_id) [unique, name: 'uq_notification_delivery_device']
    (status, next_attempt_at, id) [name: 'notification_delivery_dispatch_idx', note: 'SQL DDL은 PENDING, FAILED인 partial index']
    push_device_id [name: 'notification_delivery_device_idx', note: 'uq_notification_delivery_device의 선두 컬럼이 notification_id라 push_device_id 단독 조회를 커버하지 못한다. 기기 철회 시 전달 작업 취소와 FK RESTRICT 검사용']
  }

  checks {
    `attempt_count >= 0` [name: 'ck_notification_delivery_attempt_count']
    `(status = 'SENT') = (sent_at IS NOT NULL) AND (sent_at IS NULL OR sent_at >= created_at)` [name: 'ck_notification_delivery_sent_at']
  }

  Note: '테이블 설명: 앱 내 알림을 개별 푸시 기기로 전달한 시도, 재시도와 공급자 응답을 기록하는 테이블이다. 필요 이유: 하나의 앱 내 알림을 여러 기기에 보내는 개별 시도와 재시도·실패·공급자 응답을 추적한다.'
}

// -----------------------------------------------------------------------------
// 관계
// -----------------------------------------------------------------------------

Ref fk_region_code_parent: region_code.parent_code > region_code.code [delete: restrict]

Ref fk_user_account_region: user_account.coarse_region_code > region_code.code [delete: restrict]
Ref fk_user_private_attribute_user: user_account.id - user_private_attribute.user_id [delete: cascade]
// 실제 제약은 (user_id, role) 복합 외래키다. DBML이 복합 참조를 표현하지 못해 user_id만 적는다.
Ref fk_operator_credential_user: user_account.id - operator_credential.user_id [delete: cascade]
Ref fk_device_credential_user: device_credential.user_id > user_account.id [delete: cascade]
Ref fk_active_user_presence_user: user_account.id - active_user_presence.user_id [delete: cascade]
Ref fk_active_user_presence_region: active_user_presence.coarse_region_code > region_code.code [delete: restrict]
Ref fk_recipient_receive_state_user: user_account.id - recipient_receive_state.user_id [delete: cascade]

Ref fk_question_proposal_proposer: question_proposal.proposer_id > user_account.id [delete: restrict]
Ref fk_question_proposal_review_proposal: question_proposal_review.proposal_id > question_proposal.id [delete: restrict]
Ref fk_question_proposal_review_reviewer: question_proposal_review.reviewer_id > user_account.id [delete: restrict]
Ref fk_approved_question_source_proposal: approved_question.source_proposal_id > question_proposal.id [delete: restrict]
Ref fk_approved_question_approver: approved_question.approved_by > user_account.id [delete: restrict]
Ref fk_question_assignment_cycle_user: question_assignment_cycle.user_id > user_account.id [delete: restrict]
Ref fk_question_assignment_cycle: question_assignment.cycle_id > question_assignment_cycle.id [delete: cascade]
Ref fk_question_assignment_question: question_assignment.approved_question_id > approved_question.id [delete: restrict]

Ref fk_direction_segment_scheme: direction_segment.scheme_id > direction_scheme.id [delete: restrict]
Ref fk_media_asset_owner: media_asset.owner_id > user_account.id [delete: restrict]
Ref fk_direction_post_sender: direction_post.sender_id > user_account.id [delete: restrict]
Ref fk_direction_post_question: direction_post.approved_question_id > approved_question.id [delete: restrict]
Ref fk_direction_post_region: direction_post.coarse_region_code > region_code.code [delete: restrict]
Ref fk_post_audience_post: direction_post.id - post_audience.post_id [delete: cascade]
Ref fk_post_audience_segment: post_audience.(direction_scheme_id, selected_segment_key) > direction_segment.(scheme_id, segment_key) [delete: restrict]
Ref fk_media_attachment_asset_owner: media_attachment.(media_id, owner_id) > media_asset.(id, owner_id) [delete: restrict]
Ref fk_media_attachment_post_owner: media_attachment.(post_id, owner_id) > direction_post.(id, sender_id) [delete: cascade]
Ref fk_media_attachment_answer_owner: media_attachment.(answer_id, owner_id) > answer.(id, author_id) [delete: cascade]
Ref fk_post_recipient_post: post_recipient.post_id > direction_post.id [delete: cascade]
Ref fk_post_recipient_user: post_recipient.recipient_id > user_account.id [delete: restrict]
Ref fk_post_recipient_region: post_recipient.matched_region_code > region_code.code [delete: restrict]
Ref fk_answer_recipient_author: answer.(post_recipient_id, author_id) > post_recipient.(id, recipient_id) [delete: restrict]
Ref fk_answer_region: answer.coarse_region_code > region_code.code [delete: restrict]
Ref fk_post_reaction_recipient: post_reaction.(post_id, reactor_id) > post_recipient.(post_id, recipient_id) [delete: cascade]
Ref fk_answer_reaction_answer: answer_reaction.answer_id - answer.id [delete: cascade]
Ref fk_answer_reaction_user: answer_reaction.reactor_id > user_account.id [delete: cascade]

Ref fk_user_block_blocker: user_block.blocker_id > user_account.id [delete: cascade]
Ref fk_user_block_blocked: user_block.blocked_id > user_account.id [delete: cascade]
Ref fk_report_reporter: report.reporter_id > user_account.id [delete: restrict]
Ref fk_report_target_user: report.target_user_id > user_account.id [delete: restrict]
Ref fk_report_direction_post: report.direction_post_id > direction_post.id [delete: restrict]
Ref fk_report_answer: report.answer_id > answer.id [delete: restrict]
Ref fk_moderation_review_report: moderation_review.report_id > report.id [delete: restrict]
Ref fk_moderation_review_reviewer: moderation_review.reviewer_id > user_account.id [delete: restrict]

Ref fk_push_device_user: push_device.user_id > user_account.id [delete: cascade]
Ref fk_notification_preference_user: notification_preference.user_id > user_account.id [delete: cascade]
Ref fk_notification_recipient: notification.recipient_id > user_account.id [delete: restrict]
Ref fk_notification_outbox: notification.outbox_event_id > outbox_event.id [delete: restrict]
Ref fk_notification_post: notification.direction_post_id > direction_post.id [delete: set null]
Ref fk_notification_answer: notification.answer_id > answer.id [delete: set null]
Ref fk_notification_delivery_notification: notification_delivery.notification_id > notification.id [delete: cascade]
Ref fk_notification_delivery_device: notification_delivery.push_device_id > push_device.id [delete: restrict]

// -----------------------------------------------------------------------------
// dbdocs 그룹
// -----------------------------------------------------------------------------

TableGroup account_and_location [color: #D9EAF7, note: '계정, 지역, 위치 TTL, 수신 용량'] {
  region_code
  user_account
  user_private_attribute
  active_user_presence
  recipient_receive_state
}

TableGroup authentication [color: #DCE3EE, note: '백오피스 운영자와 앱 기기의 인증 자격증명. 제품 논리 스키마가 아니라 백엔드 인증 부록이다'] {
  operator_credential
  device_credential
}

TableGroup question_supply [color: #DFF2D8, note: '질문 제안, 운영 검토, 승인 질문, 사용자별 배정'] {
  question_proposal
  question_proposal_review
  approved_question
  question_assignment_cycle
  question_assignment
}

TableGroup direction_communication [color: #FCE4CC, note: '방향 정책, 발송 콘텐츠, 수신 권한, 답변과 공감, 미디어'] {
  direction_scheme
  direction_segment
  media_asset
  direction_post
  post_audience
  media_attachment
  post_recipient
  answer
  post_reaction
  answer_reaction
}

TableGroup safety_and_moderation [color: #F8D7DA, note: '차단, 신고, 운영 판정'] {
  user_block
  report
  moderation_review
}

TableGroup notification_and_outbox [color: #EADCF0, note: '앱 내 알림, 푸시 기기·전달, 트랜잭셔널 Outbox'] {
  push_device
  notification_preference
  outbox_event
  notification
  notification_delivery
}
