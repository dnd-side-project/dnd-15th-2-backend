#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 선택 규칙은 scripts/find-python.sh 하나에 둔다(Windows의 python3 실행 별칭을 거른다).
if PYTHON="$(sh "$ROOT/scripts/find-python.sh")"; then
  exec "$PYTHON" "$ROOT/scripts/harness.py" "$@"
fi

echo "Python 3 is required. macOS: ./scripts/setup-macos.sh --install" >&2
exit 127
